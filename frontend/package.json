{
  "name": "netra_rag",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Criminal Network Analysis System",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build:backend": "tsc -p tsconfig.backend.json && tsc -p tsconfig.workspace.json",
    "build:frontend": "next build",
    "build": "tsc -p tsconfig.backend.json && tsc -p tsconfig.workspace.json && next build",
    "start": "node dist/server.js",
    "start:frontend": "next start",
    "dev:backend": "ts-node -P tsconfig.backend.json src/server.ts",
    "dev": "next dev",
    "test": "vitest run --exclude \"dist/**\"",
    "test:watch": "vitest --exclude \"dist/**\"",
    "lint": "next lint"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^1.34.0",
    "neo4j-driver": "^5.23.0",
    "next": "14.2.35",
    "pg": "^8.12.0",
    "react": "^18",
    "react-dom": "^18",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "shared-contracts": "file:../backend/shared-contracts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.11.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^6.0.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  }
}
