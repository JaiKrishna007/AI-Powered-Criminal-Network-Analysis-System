# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connections (Demo-only default credentials)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=netra
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=demo_neo4j_password_sih
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
OLLAMA_URL=http://localhost:11434

# Internal Microservices (D3, D4, ML)
ML_SERVICE_URL=http://localhost:8001
D3_SERVICE_URL=http://localhost:8002
D4_SERVICE_URL=http://localhost:8003

# Security Secrets (Override in production deployments)
SESSION_SECRET=demo-session-secret-prototype-key
INTERNAL_SERVICE_SECRET=demo-internal-service-hmac-secret

# Storage Volumes & Paths
EVIDENCE_STORAGE_PATH=./data/evidence/
REPORTS_STORAGE_PATH=./data/reports/
